{
  "name": "react-flow-inngest",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "bun --cwd client dev",
    "dev:server": "bun --cwd server dev",
    "dev:inngest": "bunx inngest-cli@latest dev -u http://localhost:3001/api/inngest",
    "dev": "concurrently -n client,server,inngest -c cyan,green,magenta \"bun dev:client\" \"bun dev:server\" \"bun dev:inngest\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}