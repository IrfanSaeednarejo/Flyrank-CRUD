# Dependencies
node_modules
.bun

# Output / build
dist
out
*.tgz

# Environment files — NEVER bake secrets into the image
.env
.env.*
!.env.example

# Migrations are generated inside the container or copied via mount;
# don't bake them in unless you commit them.
# (If you DO commit migrations, comment these two lines out.)
# src/db/migrations
# !src/db/migrations

# Logs
logs
*.log
npm-debug.log*
bun-debug.log*

# Coverage / caches
coverage
*.lcov
.eslintcache
.cache
*.tsbuildinfo

# Editors / OS
.idea
.vscode
.DS_Store

# Git
.git
.gitignore

# Docker files themselves (not needed inside the image)
Dockerfile
docker-compose.yml
docker-compose.override.yml
.dockerignore

# Tests / docs (optional — keep if you don't want them in the image)
# tests
# *.md